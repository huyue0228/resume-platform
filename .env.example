# 已预先确定的镜像与平台参数。源码部署到 ARM 服务器时仅修改 DOCKER_PLATFORM。
APP_VERSION=latest
# 发布包的 images.env 提供下列镜像 digest；为空时使用本地构建标签。
BACKEND_IMAGE=
FRONTEND_IMAGE=
BACKUP_IMAGE=
POSTGRES_IMAGE_RELEASE=
REDIS_IMAGE_RELEASE=
AGENT_KERNEL_VERSION=dev
AGENT_KERNEL_IMAGE=smart-resume-filter-agent-kernel:dev
DOCKER_PLATFORM=linux/amd64
PYTHON_IMAGE=python:3.12.3-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_VERSION=16
POSTGRES_IMAGE=postgres:16
REDIS_VERSION=7
REDIS_IMAGE=redis:7

# Django、监控与 Agent Kernel。首次部署脚本会把五项 auto-generate 值替换为独立随机密钥，禁止手工复用。
DJANGO_SECRET_KEY=auto-generate-on-first-deploy
USAGE_METRICS_TOKEN=auto-generate-on-first-deploy
AGENT_KERNEL_TOKEN=auto-generate-on-first-deploy
AGENT_KERNEL_MCP_CONFIG=
AGENT_KERNEL_OCR_TOOL=
AGENT_KERNEL_ROLLOUT=review_only
AGENT_KERNEL_DOCUMENT_SIGNING_KEY=
AGENT_KERNEL_MODEL_INSECURE_SKIP_VERIFY=False
DJANGO_DEBUG=False
# 唯一必须按目标服务器修改的应用参数：保留 localhost，并补充实际 IP/域名。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,你的服务器IP,你的域名

# W3 OAuth2。前端仅提供 W3 登录；False 仅是首次生成 .env 的安全占位。
# 正式部署前必须补齐必填项并改为 True，否则部署脚本会在 Docker 变更前停止。
# redirect_uri 必须与 W3 平台登记值完全一致，生产示例：
# https://你的域名/api/auth/w3/callback/
W3_OAUTH2_ENABLED=False
W3_OAUTH2_CLIENT_ID=
W3_OAUTH2_CLIENT_SECRET=
W3_OAUTH2_AUTHORIZE_URL=
W3_OAUTH2_TOKEN_URL=
W3_OAUTH2_USERINFO_URL=
W3_OAUTH2_REDIRECT_URI=
W3_OAUTH2_FRONTEND_CALLBACK_URL=/login
W3_OAUTH2_SCOPE=
# 当前 W3 UserInfo 顶层字段为 employeeNumber / email；也支持嵌套点路径。
W3_OAUTH2_EMPLOYEE_NO_FIELD=employeeNumber
W3_OAUTH2_EMAIL_FIELD=email
W3_OAUTH2_CLIENT_AUTH_METHOD=client_secret_basic
W3_OAUTH2_USE_PKCE=True
W3_OAUTH2_TIMEOUT_SECONDS=10
W3_OAUTH2_TRANSACTION_TTL_SECONDS=300

# Published ports on the server.
# 同机 HTTPS 反向代理建议 FRONTEND_BIND=127.0.0.1；异机企业网关只向受控内网开放 frontend。
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=5173
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND=127.0.0.1
REDIS_PORT=6379

# 已预先确定的后端运行参数
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=1800
AI_WORKER_CONCURRENCY=20
RUN_MIGRATIONS=1
RUN_SEED_BASE=0
FILE_UPLOAD_TEMP_DIR=/app/media/tmp_uploads

# 加密备份仓库。默认约定外置/异机存储挂载到该目录；如现场挂载点不同，仅修改此项。
BACKUP_TARGET_PATH=/mnt/smart-resume-filter-backups
RESTIC_PASSWORD=auto-generate-on-first-deploy
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# 已预先确定的 PostgreSQL 标识；密码由首次部署脚本自动生成。
POSTGRES_DB=srf
POSTGRES_USER=srf_user
POSTGRES_PASSWORD=auto-generate-on-first-deploy

# AI 模型连接由管理员在系统设置 → AI 模型连接中配置并测试。
# 请勿在部署 .env 中保存模型 API Key、Base URL 或模型名称。
