{
  "$defs": {
    "AnalysisScopeV1": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactV1"
        },
        "candidate": {
          "$ref": "#/$defs/CandidateContextV1"
        },
        "jobs": {
          "items": {
            "$ref": "#/$defs/JobRequirementV1"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Jobs",
          "type": "array"
        },
        "taxonomy": {
          "items": {
            "$ref": "#/$defs/MajorAliasV1"
          },
          "title": "Taxonomy",
          "type": "array"
        },
        "volunteer_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Volunteer Ref",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "volunteer_ref",
        "artifact",
        "jobs"
      ],
      "title": "AnalysisScopeV1",
      "type": "object"
    },
    "ArtifactV1": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "expires_at": {
          "exclusiveMinimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "media_type": {
          "const": "application/pdf",
          "default": "application/pdf",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "signature": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Signature",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 33554432,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "checksum",
        "size_bytes",
        "expires_at",
        "signature"
      ],
      "title": "ArtifactV1",
      "type": "object"
    },
    "CandidateContextV1": {
      "additionalProperties": false,
      "properties": {
        "highest_education": {
          "default": "",
          "title": "Highest Education",
          "type": "string"
        },
        "highest_major": {
          "default": "",
          "title": "Highest Major",
          "type": "string"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "CandidateContextV1",
      "type": "object"
    },
    "JobRequirementV1": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "",
          "title": "Category",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "department_name": {
          "default": "",
          "title": "Department Name",
          "type": "string"
        },
        "department_ref": {
          "default": "",
          "title": "Department Ref",
          "type": "string"
        },
        "education": {
          "default": "",
          "title": "Education",
          "type": "string"
        },
        "entity": {
          "default": "",
          "title": "Entity",
          "type": "string"
        },
        "job_family": {
          "default": "",
          "title": "Job Family",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "position_name": {
          "default": "",
          "title": "Position Name",
          "type": "string"
        },
        "public_name": {
          "default": "",
          "title": "Public Name",
          "type": "string"
        },
        "ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "required_majors": {
          "items": {
            "type": "string"
          },
          "title": "Required Majors",
          "type": "array"
        },
        "responsibilities": {
          "default": "",
          "title": "Responsibilities",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "content_hash"
      ],
      "title": "JobRequirementV1",
      "type": "object"
    },
    "MajorAliasV1": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "match_type": {
          "title": "Match Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "match_type"
      ],
      "title": "MajorAliasV1",
      "type": "object"
    },
    "ModelConfigV1": {
      "additionalProperties": false,
      "properties": {
        "api_style": {
          "enum": [
            "responses",
            "chat_json"
          ],
          "title": "Api Style",
          "type": "string"
        },
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "insecure_skip_verify": {
          "default": false,
          "title": "Insecure Skip Verify",
          "type": "boolean"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "retry_count": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "structured_output_mode": {
          "default": "json_compat",
          "title": "Structured Output Mode",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 1800,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "api_style",
        "base_url",
        "model_name"
      ],
      "title": "ModelConfigV1",
      "type": "object"
    },
    "TaskBudgetV1": {
      "additionalProperties": false,
      "properties": {
        "max_duration_seconds": {
          "default": 600,
          "maximum": 1800,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_ocr_pages": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Ocr Pages",
          "type": "integer"
        },
        "max_tokens": {
          "default": 120000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 256,
          "maximum": 512,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_turns": {
          "default": 32,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        }
      },
      "title": "TaskBudgetV1",
      "type": "object"
    },
    "TaskPinV1": {
      "additionalProperties": false,
      "properties": {
        "instruction_version": {
          "const": "resume-job-match-kernel/v1",
          "default": "resume-job-match-kernel/v1",
          "title": "Instruction Version",
          "type": "string"
        },
        "kernel_build": {
          "minLength": 1,
          "title": "Kernel Build",
          "type": "string"
        },
        "model_config_revision": {
          "minLength": 1,
          "title": "Model Config Revision",
          "type": "string"
        },
        "pin_id": {
          "minLength": 1,
          "title": "Pin Id",
          "type": "string"
        },
        "policy_version": {
          "const": "django-policy-gate/v2",
          "default": "django-policy-gate/v2",
          "title": "Policy Version",
          "type": "string"
        },
        "protocol_version": {
          "const": "resume-analysis/v1",
          "default": "resume-analysis/v1",
          "title": "Protocol Version",
          "type": "string"
        },
        "result_schema_version": {
          "const": "resume-job-match/v1",
          "default": "resume-job-match/v1",
          "title": "Result Schema Version",
          "type": "string"
        },
        "toolset_version": {
          "const": "resume-job-match-tools/v1",
          "default": "resume-job-match-tools/v1",
          "title": "Toolset Version",
          "type": "string"
        }
      },
      "required": [
        "pin_id",
        "kernel_build",
        "model_config_revision"
      ],
      "title": "TaskPinV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/TaskBudgetV1"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelConfigV1"
    },
    "pin": {
      "$ref": "#/$defs/TaskPinV1"
    },
    "protocol_version": {
      "const": "resume-analysis/v1",
      "default": "resume-analysis/v1",
      "title": "Protocol Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/AnalysisScopeV1"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_kind": {
      "const": "candidate.resume_job_match",
      "default": "candidate.resume_job_match",
      "title": "Task Kind",
      "type": "string"
    },
    "trigger": {
      "default": "processing_run",
      "title": "Trigger",
      "type": "string"
    },
    "workflow_revision": {
      "minimum": 0,
      "title": "Workflow Revision",
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "idempotency_key",
    "workflow_revision",
    "pin",
    "scope",
    "model"
  ],
  "title": "AnalysisRequestV1",
  "type": "object"
}
