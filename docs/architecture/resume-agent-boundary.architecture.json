  "cards": [
    {
      "dot": "rose",
      "title": "不可跨越的权限边界",
      "items": [
        "Agent Kernel 不持有业务数据库凭据，也不直接下发、归档或占用 HC",
        "模型首轮只见 case manifest，后续只见只读工具的有界结果",
        "最终动作必须经过 Django Policy Gate 的最新状态复验与事务提交"
      ]
    },
    {
      "dot": "cyan",
      "title": "一次运行必须冻结",
      "items": [
        "kernel build / protocol / toolset / schema / policy / prompt",
        "model_config_revision 以 pin_id 固定，禁止缺失时回退 current",
        "请求与响应关联 method/path/nonce/status/body hash；跨主机使用 mTLS"
      ]
    },
    {
      "dot": "emerald",
      "title": "安全演进路径",
      "items": [
        "legacy primary + kernel shadow → kernel review_only → kernel enforced",
        "shadow 使用独立 request_id，只写运行证据，不改业务对象与计数",
        "主 Lane 失败进入可恢复状态；永不静默回退 Rule"
      ]
    }
  ]
