{
  "additionalProperties": false,
  "description": "公开兼容性固定；内部版本由内核声明，提交任务后必须精确执行冻结版本。",
  "properties": {
    "instruction_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Instruction Version",
      "type": "string"
    },
    "kernel_build": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Kernel Build",
      "type": "string"
    },
    "mock": {
      "default": false,
      "title": "Mock",
      "type": "boolean"
    },
    "protocol_version": {
      "const": "resume-analysis/v4",
      "default": "resume-analysis/v4",
      "title": "Protocol Version",
      "type": "string"
    },
    "result_schema_version": {
      "const": "resume-application-assessment/v1",
      "default": "resume-application-assessment/v1",
      "title": "Result Schema Version",
      "type": "string"
    },
    "task_kinds": {
      "items": {
        "const": "candidate.application_assessment",
        "type": "string"
      },
      "minItems": 1,
      "title": "Task Kinds",
      "type": "array"
    },
    "toolset_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Toolset Version",
      "type": "string"
    }
  },
  "required": [
    "task_kinds",
    "kernel_build",
    "toolset_version",
    "instruction_version"
  ],
  "title": "KernelCapabilitiesV1",
  "type": "object"
}
